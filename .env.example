# API keys read from the environment (see docs/models.md#credentials).
# The framework doesn't load .env itself: copy this file to .env, fill in what
# you use, then run `set -a; source .env; set +a` before abaes-eval-fwk.

# provider: openai
OPENAI_API_KEY=
# provider: deepseek
DEEPSEEK_API_KEY=
# provider: openai_compatible (optional; local servers that don't check keys need none)
PROVIDER_API_KEY=

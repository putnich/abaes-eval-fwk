# Generated by `abaes-eval-fwk init playground`/`init study`; regenerate instead of committing.
# Anchored to the repo root — do not drop the leading slash, or this also matches the
# packaged template dirs src/abaes_eval_fwk/resources/playground/,
# src/abaes_eval_fwk/config/config_files/playground/, and
# src/abaes_eval_fwk/config/config_files/study/, which must stay tracked.
/playground/
/study/
src/abaes_eval_fwk/data/datasets
# results/study is tracked; everything else under results/ is local output.
results/*
!results/study
